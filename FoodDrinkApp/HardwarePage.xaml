<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware Demo">
    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#E3F2FD, Dark=#0D1B2A}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#BBDEFB, Dark=#1B2838}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>

        <VerticalStackLayout Padding="22" Spacing="16">
            <Border StrokeThickness="0" Padding="18" BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#1565C0}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#33000000" Offset="0,4" Radius="12" Opacity="0.3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile Hardware"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Demonstrate camera, location, gyroscope, shake detection, speech, and haptic feedback."
                           FontSize="15"
                           TextColor="#E3F2FD" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2838}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Food Photo" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}" />
                            <Label Text="Capture the colour and condition of the meal." FontSize="13" TextColor="{AppThemeBinding Light=#546E7A, Dark=#90CAF9}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Photo"
                                BackgroundColor="#1565C0"
                                TextColor="#FFFFFF"
                                Clicked="OnTakePhotoClicked"
                                SemanticProperties.Hint="Open the camera to capture a food image" />
                    </Grid>
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D1B2A}"
                            HeightRequest="220">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Image x:Name="FoodPhoto"
                               Aspect="AspectFill"
                               SemanticProperties.Description="Captured food photo preview" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2838}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Meal Location" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}" />
                            <Label Text="Show country, city, region, and coordinates." FontSize="13" TextColor="{AppThemeBinding Light=#546E7A, Dark=#90CAF9}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Locate"
                                BackgroundColor="#1565C0"
                                TextColor="#FFFFFF"
                                Clicked="OnGetLocationClicked"
                                SemanticProperties.Hint="Use location to record the meal place" />
                    </Grid>
                    <Label x:Name="LocationLabel"
                           Grid.Row="1"
                           Text="Location has not been captured yet."
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#455A64, Dark=#90CAF9}" />
                    <Label x:Name="CoordinateLabel"
                           Grid.Row="2"
                           Text="Coordinates will appear here."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#78909C, Dark=#64B5F6}" />
                </Grid>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2838}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Gyroscope / Compass" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0288D1, Dark=#4FC3F7}" />
                            <Label Text="Display device orientation and compass heading." FontSize="13" TextColor="{AppThemeBinding Light=#546E7A, Dark=#90CAF9}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                x:Name="GyroToggleButton"
                                Text="Start"
                                BackgroundColor="#0288D1"
                                TextColor="#FFFFFF"
                                Clicked="OnGyroToggled"
                                SemanticProperties.Hint="Toggle gyroscope and compass readings" />
                    </Grid>
                    <Label x:Name="GyroLabel"
                           Grid.Row="1"
                           Text="Gyroscope: Not active"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#455A64, Dark=#90CAF9}" />
                    <Label x:Name="CompassLabel"
                           Grid.Row="2"
                           Text="Compass: Not active"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#78909C, Dark=#64B5F6}" />
                </Grid>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2838}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Shake Detection" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0277BD, Dark=#29B6F6}" />
                            <Label Text="Shake your device to trigger a special action." FontSize="13" TextColor="{AppThemeBinding Light=#546E7A, Dark=#90CAF9}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                x:Name="ShakeToggleButton"
                                Text="Enable"
                                BackgroundColor="#0277BD"
                                TextColor="#FFFFFF"
                                Clicked="OnShakeToggled"
                                SemanticProperties.Hint="Enable shake detection feature" />
                    </Grid>
                    <Label x:Name="ShakeStatusLabel"
                           Grid.Row="1"
                           Text="Shake detection: Disabled"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#455A64, Dark=#90CAF9}" />
                    <Label x:Name="ShakeCountLabel"
                           Grid.Row="2"
                           Text="Shake count: 0"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#78909C, Dark=#64B5F6}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read help"
                        BackgroundColor="#0288D1"
                        TextColor="#FFFFFF"
                        Clicked="OnReadHelpClicked"
                        SemanticProperties.Hint="Read the help text aloud" />
                <Button Grid.Column="1"
                        Text="Stop speech"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2838}"
                        BorderColor="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}"
                        BorderWidth="1"
                        TextColor="#0277BD"
                        Clicked="OnStopSpeechClicked"
                        SemanticProperties.Hint="Stop current speech" />
            </Grid>

            <Button Text="Haptic Feedback"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2838}"
                    BorderColor="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}"
                    BorderWidth="1"
                    TextColor="#0277BD"
                    Clicked="OnFeedbackClicked"
                    SemanticProperties.Hint="Trigger vibration and haptic feedback" />

            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D1B2A}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HardwareStatusLabel"
                           Text="Ready."
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#01579B, Dark=#4FC3F7}" />
                    <Label x:Name="FeedbackCountLabel"
                           Text="Haptic feedback tests: 0"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#455A64, Dark=#90CAF9}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>