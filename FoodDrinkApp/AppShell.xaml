<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodDrinkApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodDrinkApp"
    Title="NutriBite"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D1B2A}"
    Shell.ForegroundColor="{AppThemeBinding Light=#0D47A1, Dark=#E3F2FD}"
    Shell.TitleColor="{AppThemeBinding Light=#0D47A1, Dark=#E3F2FD}"
    Shell.UnselectedColor="{AppThemeBinding Light=#546E7A, Dark=#90CAF9}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D1B2A}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#1565C0, Dark=#4FC3F7}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#1565C0, Dark=#4FC3F7}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#546E7A, Dark=#90CAF9}">

    <TabBar>
        <ShellContent
            Title="Foods"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Hardware"
            ContentTemplate="{DataTemplate local:HardwarePage}"
            Route="HardwarePage" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>
</Shell>